{
  "$comment": "GTFS relational and field semantics, shared by the Python backend (core/schema.py) and any JavaScript/TypeScript consumer. Keyed by table, then by field. A table's \"presence\" says whether a feed must contain that file. A field's \"type\" names an entry in \"fieldTypes\", which carries what a value of that type must look like. GENERATED from schema/gtfs.yaml by scripts/build_schema_json.py - edit that, not this. Keys are camelCase so this reads naturally from TypeScript.",
  "fieldTypes": {
    "COLOR": {
      "description": "A color encoded as a six-digit hexadecimal number. The leading \"#\" is not included.",
      "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "CURRENCY_AMOUNT": {
      "description": "A decimal value indicating a currency amount."
    },
    "CURRENCY_CODE": {
      "description": "An ISO 4217 alphabetical currency code.",
      "pattern": "^[A-Z]{3}$"
    },
    "DATE": {
      "description": "Service day in the YYYYMMDD format. Since time within a service day may be above 24:00:00, a service day may contain information for the subsequent day(s).",
      "pattern": "^\\d{8}$"
    },
    "EMAIL": {
      "description": "An email address.",
      "pattern": "^[^\\s@:]+@[^\\s@:]+$"
    },
    "FLOAT": {
      "description": "A floating point number."
    },
    "ID": {
      "description": "An internal ID, not intended to be shown to riders, and is a sequence of any UTF-8 characters. Using only printable ASCII characters is recommended."
    },
    "INTEGER": {
      "description": "An integer.",
      "pattern": "^[+-]?\\d+$"
    },
    "LANGUAGE_CODE": {
      "description": "An IETF BCP 47 language code."
    },
    "LATITUDE": {
      "description": "WGS84 latitude in decimal degrees. The value must be greater than or equal to -90.0 and less than or equal to 90.0.",
      "minimum": -90,
      "maximum": 90
    },
    "LONGITUDE": {
      "description": "WGS84 longitude in decimal degrees. The value must be greater than or equal to -180.0 and less than or equal to 180.0.",
      "minimum": -180,
      "maximum": 180
    },
    "PHONE_NUMBER": {
      "description": "A phone number."
    },
    "TEXT": {
      "description": "A string of UTF-8 characters, which is aimed to be displayed and which must therefore be human readable."
    },
    "TIME": {
      "description": "Time in the HH:MM:SS format (H:MM:SS is also accepted). For times occurring after midnight on the service day, enter the time as a value greater than 24:00:00.",
      "pattern": "^\\d{1,2}:\\d{2}:\\d{2}$"
    },
    "TIMEZONE": {
      "description": "TZ timezone from the IANA time-zones. Timezone names never contain the space character but may contain an underscore.",
      "pattern": "^\\S+$"
    },
    "URL": {
      "description": "A fully qualified URL that includes http:// or https://, and any special characters in the URL must be correctly escaped.",
      "pattern": "^https?://"
    }
  },
  "tables": {
    "agency": {
      "presence": "required",
      "fields": {
        "agency_id": {
          "type": "ID",
          "required": "conditional",
          "condition": "Required when the feed contains more than one agency.",
          "conditionScope": "feed",
          "conditionCheck": {
            "kind": "row_count",
            "file": "agency",
            "minimum": 2
          },
          "primaryKey": true
        },
        "agency_name": {
          "type": "TEXT",
          "required": "always"
        },
        "agency_url": {
          "type": "URL",
          "required": "always"
        },
        "agency_timezone": {
          "type": "TIMEZONE",
          "required": "always"
        },
        "agency_lang": {
          "type": "LANGUAGE_CODE"
        },
        "agency_phone": {
          "type": "PHONE_NUMBER"
        },
        "agency_fare_url": {
          "type": "URL"
        },
        "agency_email": {
          "type": "EMAIL"
        },
        "cemv_support": {
          "type": "ENUM",
          "values": {
            "0": "No Information",
            "1": "Supported",
            "2": "Not Supported"
          },
          "whenEmpty": {
            "code": "0",
            "label": "No Information"
          }
        }
      }
    },
    "areas": {
